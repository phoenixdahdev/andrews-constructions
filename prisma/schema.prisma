generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  email            String           @unique
  password         String?
  date_joined      DateTime         @default(now())
  time             String?
  region           String?
  country          String?
  last_seen        DateTime?
  two_step_enabled Boolean          @default(false)
  created_at       DateTime         @default(now()) @db.Timestamptz()
  updated_at       DateTime         @default(now()) @updatedAt @db.Timestamptz()
  is_active        Boolean          @default(true)
  login_activities login_activity[]
  cad_drawings     cad_drawing[]
  material_orders  material_order[]
  settings         user_settings?
  profile_image    String?
  role             user_role        @default(USER)
  notifications    notification[]   @relation("user_notifications")
  conversations    conversation[]   @relation("user_conversations")
}

model user_settings {
  id                      String  @id @default(uuid()) @db.Uuid
  user_id                 String  @unique @db.Uuid
  user                    user    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  enable_notifications    Boolean @default(true)
  notify_material_changes Boolean @default(true)
  notify_system_updates   Boolean @default(true)
  theme                   String? @default("light")
  language                String? @default("en")

  @@map("user_settings")
}

model login_activity {
  id          String       @id @default(uuid()) @db.Uuid
  user_id     String       @db.Uuid
  user        user         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  login_time  DateTime     @default(now()) @db.Timestamptz()
  status      login_status
  ip_address  String?
  device_info String?
  location    String?

  @@index([user_id])
  @@map("login_activities")
}

model cad_drawing {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  file_path       String
  file_type       String
  document_type   String?
  user_id         String           @db.Uuid
  user            user             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  uploaded_at     DateTime         @default(now()) @db.Timestamptz()
  measurements    measurement[]
  materials       material_needs[]
  document_info   document_info?
  features        feature[]
  assemblies      assembly[]
  classifications classification[]

  @@index([user_id])
  @@map("cad_drawings")
}

model document_info {
  id         String      @id @default(uuid()) @db.Uuid
  drawing_id String      @unique @db.Uuid
  drawing    cad_drawing @relation(fields: [drawing_id], references: [id], onDelete: Cascade)
  title      String?
  reference  String?
  date       String?
  revision   String?
  author     String?
  project    String?
  client     String?
  created_at DateTime    @default(now()) @db.Timestamptz()
  updated_at DateTime    @updatedAt @db.Timestamptz()

  @@map("document_info")
}

model measurement {
  id               String           @id @default(uuid()) @db.Uuid
  drawing_id       String           @db.Uuid
  drawing          cad_drawing      @relation(fields: [drawing_id], references: [id], onDelete: Cascade)
  measurement_type measurement_type
  category         String?
  name             String
  size             String
  value            Float?
  unit             String?
  x_coordinate     Float?
  y_coordinate     Float?
  created_at       DateTime         @default(now()) @db.Timestamptz()

  @@index([drawing_id])
  @@map("measurements")
}

model material_needs {
  id          String      @id @default(uuid()) @db.Uuid
  drawing_id  String      @db.Uuid
  drawing     cad_drawing @relation(fields: [drawing_id], references: [id], onDelete: Cascade)
  material_id String      @db.Uuid
  material    material    @relation(fields: [material_id], references: [id], onDelete: Cascade)
  quantity    Float
  unit        String
  created_at  DateTime    @default(now()) @db.Timestamptz()

  @@index([drawing_id])
  @@index([material_id])
  @@map("material_needs")
}

model material {
  id              String            @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  specification   String?
  category        material_category
  unit_price      Float
  currency        String            @default("USD")
  in_stock        Boolean           @default(true)
  material_needs  material_needs[]
  material_orders material_order[]

  @@map("materials")
}

model material_order {
  id          String       @id @default(uuid()) @db.Uuid
  user_id     String       @db.Uuid
  user        user         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  material_id String       @db.Uuid
  material    material     @relation(fields: [material_id], references: [id], onDelete: Cascade)
  quantity    Float
  total_price Float
  status      order_status @default(PENDING)
  created_at  DateTime     @default(now()) @db.Timestamptz()
  updated_at  DateTime     @updatedAt @db.Timestamptz()

  @@index([user_id])
  @@index([material_id])
  @@map("material_orders")
}

model classification {
  id            String              @id @default(uuid()) @db.Uuid
  drawing_id    String              @db.Uuid
  drawing       cad_drawing         @relation(fields: [drawing_id], references: [id], onDelete: Cascade)
  category      classification_type
  name          String
  specification String
  created_at    DateTime            @default(now()) @db.Timestamptz()
  updated_at    DateTime            @updatedAt @db.Timestamptz()

  @@index([drawing_id])
  @@map("classifications")
}

model assembly {
  id          String      @id @default(uuid()) @db.Uuid
  drawing_id  String      @db.Uuid
  drawing     cad_drawing @relation(fields: [drawing_id], references: [id], onDelete: Cascade)
  name        String
  description String
  created_at  DateTime    @default(now()) @db.Timestamptz()
  updated_at  DateTime    @updatedAt @db.Timestamptz()

  @@index([drawing_id])
  @@map("assemblies")
}

model feature {
  id          String      @id @default(uuid()) @db.Uuid
  drawing_id  String      @db.Uuid
  drawing     cad_drawing @relation(fields: [drawing_id], references: [id], onDelete: Cascade)
  name        String
  description String
  created_at  DateTime    @default(now()) @db.Timestamptz()
  updated_at  DateTime    @updatedAt @db.Timestamptz()

  @@index([drawing_id])
  @@map("features")
}

model testimonial {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  position    String?
  company     String?
  content     String
  rating      Int      @default(5)
  is_featured Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz()

  @@map("testimonials")
}

model notification {
  id         String            @id @default(uuid()) @db.Uuid
  user_id    String            @db.Uuid
  type       notification_type
  title      String
  message    String
  is_read    Boolean           @default(false)
  created_by String?           @db.Uuid
  created_at DateTime          @default(now()) @db.Timestamptz()
  updated_at DateTime          @default(now()) @updatedAt @db.Timestamptz()

  user user @relation("user_notifications", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("notifications")
}

model conversation {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?
  user_id     String    @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz()
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz()
  user        user      @relation("user_conversations", fields: [user_id], references: [id], onDelete: Cascade)
  messages    message[] @relation("conversation_messages")

  @@index([user_id])
  @@map("conversations")
}

model message {
  id              String       @id @default(uuid()) @db.Uuid
  conversationId  String       @db.Uuid
  conversation    conversation @relation("conversation_messages", fields: [conversationId], references: [id], onDelete: Cascade)
  role            MessageRole
  content         String
  image_url       String?
  image_file_name String?
  metadata        Json?
  created_at      DateTime     @default(now()) @db.Timestamptz()

  @@map("messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum user_role {
  ADMIN
  USER
  CONTRACTOR
}

enum login_status {
  SUCCESS
  FAILURE
}

enum order_status {
  PENDING
  APPROVED
  DELIVERED
  CANCELLED
}

enum notification_type {
  DEPOSIT_CONFIRMATION
  WITHDRAWAL_REQUEST
  WITHDRAWAL_PROCESSED
  WITHDRAWAL_DENIED
  INTEREST_PAID
  FUND_LOCK_EXPIRING
  SYSTEM_NOTIFICATION
  MATERIAL_CHANGE
  SYSTEM_UPDATE
}

enum measurement_type {
  STRUCTURAL_ELEMENT
  ROOM
  COMPONENT
  SPACING
  THICKNESS
  TOTAL_THICKNESS
  OTHER
}

enum material_category {
  STRUCTURAL
  INSULATION
  FIRE_PROTECTION
  MEMBRANE
  FASTENER
  SHEATHING
  SURFACE_MATERIAL
  OTHER
}

enum classification_type {
  FIRE_RATING
  ENVIRONMENTAL
  STANDARDS_COMPLIANCE
  OTHER
}
