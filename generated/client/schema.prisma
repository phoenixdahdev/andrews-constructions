generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id               String           @id @default(uuid())
  name             String
  email            String           @unique
  password         String?
  provider         String?
  date_joined      DateTime         @default(now())
  time             String?
  region           String?
  country          String?
  last_seen        DateTime?
  two_step_enabled Boolean          @default(false)
  login_activities login_activity[]
  projects         project[]
  cad_drawings     cad_drawing[]
  material_orders  material_order[]
  settings         user_settings?
  profile_image    String?
  role             user_role        @default(USER)
}

model user_settings {
  id                      String  @id @default(uuid())
  user_id                 String  @unique
  user                    user    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  enable_notifications    Boolean @default(true)
  notify_material_changes Boolean @default(true)
  notify_system_updates   Boolean @default(true)
  theme                   String? @default("light")
  language                String? @default("en")
}

model login_activity {
  id          String       @id @default(uuid())
  user_id     String
  user        user         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  login_time  DateTime     @default(now())
  status      login_status
  ip_address  String?
  device_info String?
  location    String?
}

model project {
  id           String        @id @default(uuid())
  name         String
  description  String?
  user_id      String
  user         user          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  cad_drawings cad_drawing[]
}

model cad_drawing {
  id           String           @id @default(uuid())
  name         String
  file_path    String
  project_id   String?
  project      project?         @relation(fields: [project_id], references: [id], onDelete: SetNull)
  user_id      String
  user         user             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  uploaded_at  DateTime         @default(now())
  measurements measurement[]
  materials    material_needs[]
}

model measurement {
  id               String      @id @default(uuid())
  drawing_id       String
  drawing          cad_drawing @relation(fields: [drawing_id], references: [id], onDelete: Cascade)
  measurement_type String
  value            Float
  unit             String
  x_coordinate     Float?
  y_coordinate     Float?
  created_at       DateTime    @default(now())
}

model material_needs {
  id          String      @id @default(uuid())
  drawing_id  String
  drawing     cad_drawing @relation(fields: [drawing_id], references: [id], onDelete: Cascade)
  material_id String
  material    material    @relation(fields: [material_id], references: [id], onDelete: Cascade)
  quantity    Float
  unit        String
  created_at  DateTime    @default(now())
}

model material {
  id              String           @id @default(uuid())
  name            String
  description     String?
  unit_price      Float
  currency        String           @default("USD")
  in_stock        Boolean          @default(true)
  material_needs  material_needs[]
  material_orders material_order[]
}

model material_order {
  id          String       @id @default(uuid())
  user_id     String
  user        user         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  material_id String
  material    material     @relation(fields: [material_id], references: [id], onDelete: Cascade)
  quantity    Float
  total_price Float
  status      order_status @default(PENDING)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
}

model testimonial {
  id          String   @id @default(uuid())
  name        String
  position    String?
  company     String?
  content     String
  rating      Int      @default(5)
  is_featured Boolean  @default(false)
  created_at  DateTime @default(now())
}

enum user_role {
  ADMIN
  USER
  CONTRACTOR
}

enum login_status {
  SUCCESS
  FAILURE
}

enum order_status {
  PENDING
  APPROVED
  DELIVERED
  CANCELLED
}
